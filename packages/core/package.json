{
  "name": "@milkui/core",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": "https://github.com/milkui/components",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./accordion": {
      "types": "./dist/accordion/index.d.ts",
      "default": "./dist/accordion/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "default": "./dist/button/index.js"
    },
    "./collapsible": {
      "types": "./dist/collapsible/index.d.ts",
      "default": "./dist/collapsible/index.js"
    },
    "./primitive": {
      "types": "./dist/primitive/index.d.ts",
      "default": "./dist/primitive/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build --force",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.type-tests.json"
  },
  "dependencies": {
    "dom-types": "^1.1.5"
  }
}
